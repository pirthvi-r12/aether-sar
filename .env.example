# TiDB Cloud or local MySQL. DB_SSL=true uses TLS with rejectUnauthorized.
DB_HOST=gateway01.example.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=darkfleet
DB_SSL=true

# Optional single URL. Used when DB_HOST and DB_NAME are not both set.
# mysql://USER:PASSWORD@gateway01.example.prod.aws.tidbcloud.com:4000/darkfleet?ssl=true
# postgresql://USER:PASSWORD@ep-example.neon.tech/darkfleet?sslmode=require
DATABASE_URL=
